{
  "name": "wineglass",
  "version": "0.1.0",
  "description": "Compare native macOS Chromium with Windows Chromium running under Wine, entirely on one Mac.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wineglass": "dist/bin/wineglass.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup:wine": "npm run build && node dist/bin/setup-wine.js",
    "demo": "npm run build && node dist/bin/wineglass.js --demo",
    "check": "npm run build && node dist/scripts/check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvoryCanvas/WineGlass.git"
  },
  "homepage": "https://github.com/IvoryCanvas/WineGlass#readme",
  "bugs": {
    "url": "https://github.com/IvoryCanvas/WineGlass/issues"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
